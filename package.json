{
  "name": "cfmail",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "node scripts/check-config.mjs && npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "domain:add": "node scripts/add-domain.mjs",
    "types": "wrangler types src/worker/bindings.d.ts --config wrangler.example.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "hono": "^4.13.1",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "postal-mime": "^2.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tinyld": "^1.3.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.126.0"
  }
}
